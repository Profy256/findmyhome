# Find My Home — Web App Environment Variables
# Copy this file to .env.local and fill in your values.

# ── API ───────────────────────────────────────────────────────────────────────
# Point to your Laravel API (local or production)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Cloudinary (for direct KYC document uploads from the browser) ─────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_LISTINGS_PRESET=findmyhome_listings
NEXT_PUBLIC_CLOUDINARY_KYC_PRESET=findmyhome_kyc
