APP_NAME="Find My Home"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate_--show
APP_DEBUG=false
APP_URL=https://your-api-domain.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=findmyhome
DB_USERNAME=postgres
DB_PASSWORD=your_strong_password_here

# ── Cache & Queue ─────────────────────────────────────────────────────────────
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (Resend) ─────────────────────────────────────────────────────────────
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@findmyhome.ug
MAIL_FROM_NAME="Find My Home"
RESEND_API_KEY=re_your_resend_api_key_here

# ── Cloudinary (Media Storage) ────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=findmyhome_kyc

# ── Google Vision AI (KYC Document Analysis) ──────────────────────────────────
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# ── Africa's Talking (SMS) ────────────────────────────────────────────────────
AT_USERNAME=your_at_username
AT_API_KEY=your_at_api_key
AT_SENDER_ID=FINDMYHOME

# ── Pesapal (Payments) ────────────────────────────────────────────────────────
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_ENVIRONMENT=live
# IPN callback URL must be registered with Pesapal
PESAPAL_IPN_URL=https://your-api-domain.railway.app/api/v1/bookings/pesapal-ipn

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-web-domain.vercel.app

# ── Sanctum ───────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=your-web-domain.vercel.app,your-admin-domain.vercel.app
