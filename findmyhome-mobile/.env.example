# Find My Home — Mobile App Environment Variables
# Copy this file to .env and fill in your values.
# Expo only picks up variables prefixed with EXPO_PUBLIC_

# ── API ───────────────────────────────────────────────────────────────────────
# Local dev: replace with your machine's LAN IP (find it with `ipconfig` on Windows / `ifconfig` on Mac)
# Production: https://findmyhome-api.onrender.com/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api/v1

# ── Cloudinary (direct media uploads from the app) ───────────────────────────
# Cloud name from: cloudinary.com/console → Dashboard
# Upload preset: cloudinary.com → Settings → Upload → findmyhome_photos (unsigned)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=findmyhome_photos

# ── Web App URL ───────────────────────────────────────────────────────────────
# Reservations, invoice settlements, and account actions open this URL in the browser
# Production: your custom domain or Vercel URL
EXPO_PUBLIC_WEB_URL=https://findmyhomeuganda.com
