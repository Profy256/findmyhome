# Find My Home — Mobile App Environment Variables
# Copy this file to .env and fill in your values.
# Expo only picks up variables prefixed with EXPO_PUBLIC_

# ── API ───────────────────────────────────────────────────────────────────────
# For local dev: use your machine's LAN IP (not localhost — Android emulator can't reach it)
# Example: http://192.168.1.100:8000/api/v1
# For production: your Railway API URL
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api/v1

# ── Cloudinary (for direct media uploads from the app) ────────────────────────
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=findmyhome_media
