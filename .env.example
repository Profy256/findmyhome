# Find My Home — Environment Variables Reference
# Copy this file to findmyhome-go/.env and fill in your real values.
# In production (Render), paste each key into the Render dashboard → Environment.
# ⚠️  Never commit the real .env file — it is gitignored.

# ── Server ────────────────────────────────────────────────────────────────────
ADDR=:8000
APP_ENV=production                        # production | development
APP_URL=https://findmyhome-api.onrender.com
GIN_MODE=release                          # debug | release

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Use the Neon POOLER endpoint (PgBouncer, transaction mode)
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app
ADMIN_URL=https://your-admin.vercel.app

# ── Public API base URL (used in Pesapal IPN callbacks) ───────────────────────
PUBLIC_API_URL=https://findmyhome-api.onrender.com

# ── Cloudinary (property photos + KYC documents) ─────────────────────────────
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_KEY=re_your_resend_api_key
MAIL_FROM_ADDRESS=hello@findmyhome.com
MAIL_FROM_NAME="Find My Home"

# ── Africa's Talking (SMS notifications) ─────────────────────────────────────
AT_USERNAME=your_africas_talking_username
AT_API_KEY=your_africas_talking_api_key
AT_SENDER_ID=FindMyHome

# ── Google Vision API (KYC AI auto-verification) ─────────────────────────────
GOOGLE_VISION_API_KEY=your_google_vision_api_key
FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json
FIREBASE_PROJECT_ID=your_firebase_project_id

# ── Pesapal (payments) ────────────────────────────────────────────────────────
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_ENV=sandbox                       # sandbox | production

# ── First-run admin seed (used once with: go run ./cmd/seed) ─────────────────
# Remove these after seeding. Never commit real values.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-min-8-chars
