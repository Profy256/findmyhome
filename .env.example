# Find My Home — Environment Variables Reference
# Copy this file to .env (same directory as docker-compose.yml) and fill in real values.

# ── Server ────────────────────────────────────────────────────────────────────
ADDR=:8000
GIN_MODE=release                      # debug | release

# ── Database ──────────────────────────────────────────────────────────────────
# Used by docker-compose to create the Postgres container
DB_DATABASE=findmyhome
DB_USERNAME=postgres
DB_PASSWORD=your_strong_password_here

# Full DSN used by the Go API (docker-compose builds this automatically)
# DATABASE_URL=postgres://postgres:password@localhost:5432/findmyhome?sslmode=disable

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000     # Set to your Vercel URL in production

# ── Public API base URL (used in Pesapal IPN callbacks) ───────────────────────
PUBLIC_API_URL=http://localhost:8000   # Set to your Render URL in production

# ── Pesapal Payments ──────────────────────────────────────────────────────────
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_ENV=sandbox                   # sandbox | production
