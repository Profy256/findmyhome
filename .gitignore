# Ignore all .env files by default globally
.env
.env.*
.env.local
.env.*.local

# But DO track environment template examples
!.env.example
!.env.local.example
!*/.env.example
!*/.env.local.example

# Common global ignores
node_modules/
.next/
**/.next/
.turbo/
**/.turbo/
dist/
build/
.vercel/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea/
.vscode/

# Go build artifacts
findmyhome-go/findmyhome-api
findmyhome-go/server
findmyhome-go/*.exe
*.exe

# Go test cache (local only)
findmyhome-go/tmp/

# Build logs and output
*.log
*_log*.txt
*_out.txt
*_error.txt
